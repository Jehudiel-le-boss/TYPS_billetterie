# ───────── TYPS — variables d'environnement (ne jamais committer .env) ─────────

# Base de données Neon PostgreSQL (chaîne de connexion « pooled » ou directe)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# URL publique du site (sert aux liens e-mail, callbacks FedaPay, QR de l'événement)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Secrets applicatifs (openssl rand -base64 48) — obligatoires en production
SESSION_SECRET=change-me-long-random
QR_SECRET=change-me-another-long-random
CRON_SECRET=change-me-for-cron-endpoint

# Environnement d'exécution : laisser vide (= production) ou "staging" / "development" pour une recette. Le mode démo n'est possible que hors production.
APP_ENV=

# Mode : "sandbox" (par défaut) ou "live". Le mode démonstration n'utilise JAMAIS FedaPay.
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY_SANDBOX=
FEDAPAY_SECRET_KEY_LIVE=
# Secret de l'endpoint webhook (Tableau de bord FedaPay > Webhooks > Copier la clé), distinct sandbox / live
FEDAPAY_WEBHOOK_SECRET_SANDBOX=
FEDAPAY_WEBHOOK_SECRET_LIVE=

# Activer le mode démonstration (paiement simulé local, billets marqués DÉMO). Interdit en production.
DEMO_MODE=false

# Stockage compatible S3 (R2, S3, MinIO…). Sans ces variables : stockage disque local .data/uploads (dev uniquement)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mails (Resend). Sans clé : les e-mails sont journalisés (notification_logs) mais non envoyés.
RESEND_API_KEY=
MAIL_FROM="TYPS <billets@exemple.com>"

# Premier administrateur de la plateforme (e-mail du compte promu au démarrage du seed)
BOOTSTRAP_ADMIN_EMAIL=
